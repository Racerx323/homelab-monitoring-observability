# The caller records and verifies this local base image ID before building.
FROM localhost/svmf-network-wrapper:bookworm
RUN apt-get update && apt-get install -y --no-install-recommends \
    apache2 libapache2-mod-fcgid libfcgi-perl openssl \
    && rm -rf /var/lib/apt/lists/*
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
