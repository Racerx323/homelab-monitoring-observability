[caddy_health]
user root

[caddy_requests]
user munin
env.metrics_url http://127.0.0.1:2019/metrics

[caddy_tls]
user munin
group caddy-tls
env.certificate /etc/caddy/current/tls/leaf.pem

[lsyncd_caddy]
user root
env.status_file /run/caddy-lsyncd/status
env.incoming_root /var/lib/caddy-sync/incoming
env.quarantine_root /var/lib/caddy-sync/quarantine

