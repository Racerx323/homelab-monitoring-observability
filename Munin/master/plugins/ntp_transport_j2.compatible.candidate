#!/usr/bin/python3
"""Unprivileged scheduled full-protocol checks, without duplicate metric storage."""
from concurrent.futures import ThreadPoolExecutor
import json
import math
import os
import pwd
import grp
from pathlib import Path
import re
import socket
import stat
import sys
import time

PLUGINS=set(['acpi', 'cpu', 'cpuspeed', 'df', 'df_inode', 'diskstats', 'entropy', 'forks', 'fw_packets', 'if_err_eth0', 'if_err_wlan0', 'if_eth0', 'if_wlan0', 'interrupts', 'irqstats', 'load', 'memory', 'netstat', 'nfs4_client', 'nfs_client', 'ntp_health', 'ntp_jobs', 'ntp_statistics', 'ntp_storage', 'open_files', 'open_inodes', 'proc_pri', 'processes', 'swap', 'threads', 'uptime', 'users', 'vmstat'])  # Public selected-set metadata; compatibility uses PLUGIN_SETS.
PLUGIN_SETS=(frozenset(['cpu', 'load', 'memory', 'ntp_health', 'ntp_jobs', 'ntp_statistics', 'ntp_storage', 'processes', 'uptime']),frozenset(['acpi', 'cpu', 'cpuspeed', 'df', 'df_inode', 'diskstats', 'entropy', 'forks', 'fw_packets', 'if_err_eth0', 'if_err_wlan0', 'if_eth0', 'if_wlan0', 'interrupts', 'irqstats', 'load', 'memory', 'netstat', 'nfs4_client', 'nfs_client', 'ntp_health', 'ntp_jobs', 'ntp_statistics', 'ntp_storage', 'open_files', 'open_inodes', 'proc_pri', 'processes', 'swap', 'threads', 'uptime', 'users', 'vmstat']),)
ENDPOINTS=((socket.AF_INET,'10.1.0.51','10.1.3.83'),
           (socket.AF_INET6,'fd36:5aa8:6971:1::51','fd36:5aa8:6971:1::83'))
STATUS=Path('/var/lib/munin/ntp-alerts/status.json')


def check(endpoint,connect=socket.socket):
    family,target,source=endpoint;deadline=time.monotonic()+25
    with connect(family,socket.SOCK_STREAM) as connection:
        connection.settimeout(3);connection.bind((source,0));connection.connect((target,4949))
        with connection.makefile('rb') as stream:
            def line():
                remaining=deadline-time.monotonic()
                if remaining<=0:raise TimeoutError('protocol deadline')
                connection.settimeout(min(10,remaining))
                raw=stream.readline(8193)
                if not raw or len(raw)>8192 or not raw.endswith(b'\n'):raise ValueError('bounded protocol line required')
                return raw.decode('ascii').strip()
            def send(command):connection.sendall(command.encode()+b'\n')
            def frame():
                rows=[];size=0
                for _ in range(4096):
                    text=line()
                    if text=='.':return rows
                    size+=len(text)
                    if size>262144 or text.startswith('# Unknown'):raise ValueError('invalid protocol frame')
                    rows.append(text)
                raise ValueError('unterminated protocol frame')
            if line()!='# munin node at j2-svntp1':raise ValueError('node identity mismatch')
            send('cap multigraph')
            if 'multigraph' not in line().split():raise ValueError('multigraph capability missing')
            send('list j2-svntp1')
            selected=set(line().split())
            if selected not in PLUGIN_SETS:raise ValueError('plugin set mismatch')
            for plugin in sorted(selected):
                send('config '+plugin)
                rows=frame()
                if not any(r.startswith('graph_title ') for r in rows):raise ValueError('missing plugin configuration')
                expected=set();computed=set();graph=''
                for row in rows:
                    if row.startswith('multigraph '):graph=row.split(' ',1)[1]
                    match=re.fullmatch(r'([A-Za-z0-9_]+)\.(label|cdef) (.+)',row)
                    if match:
                        if match[2]=='label':expected.add((graph,match[1]))
                        elif match[1] not in match[3].split(','):computed.add((graph,match[1]))
                expected-=computed
                if not expected:raise ValueError('missing configured fields')
                send('fetch '+plugin);rows=frame();found=set();graph=''
                for row in rows:
                    if row.startswith('multigraph '):graph=row.split(' ',1)[1];continue
                    if not row or row.startswith('#'):continue
                    match=re.fullmatch(r'([A-Za-z0-9_]+)\.value (?:U|[-+]?(?:[0-9]+(?:\.[0-9]*)?|\.[0-9]+)(?:[eE][-+]?[0-9]+)?)',row)
                    if not match:raise ValueError('invalid plugin value')
                    key=(graph,match[1])
                    if key in found:raise ValueError('duplicate plugin value')
                    found.add(key)
                if not expected<=found:raise ValueError('missing configured plugin values')
                # U is valid transport evidence; the canonical graphs own data health.
            send('quit')
    return 1


def submission_status(path=STATUS):
    try:
        if path.is_symlink() or any(p.is_symlink() for p in path.parents):return 'U'
        fd=os.open(path,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK)
        with os.fdopen(fd,'rb') as f:
            m=os.fstat(f.fileno())
            if not stat.S_ISREG(m.st_mode) or m.st_uid!=os.geteuid() or m.st_nlink!=1 or stat.S_IMODE(m.st_mode)!=0o600 or m.st_size>4096:return 'U'
            data=json.loads(f.read(4097))
        if (not isinstance(data,dict) or data.get('schema')!=1 or type(data.get('submission_ok')) is not bool
                or type(data.get('attempt_epoch')) not in (int,float) or not math.isfinite(data['attempt_epoch'])):return 'U'
        return int(data['submission_ok'])
    except (OSError,ValueError,TypeError):return 'U'


def config():
    return '''graph_title j2-svntp1 scheduled transport and alert submission
graph_category ntp
graph_vlabel state
graph_args --lower-limit 0 --upper-limit 1
v4.label IPv4 full protocol
v4.type GAUGE
v4.critical 1:1
v6.label IPv6 full protocol
v6.type GAUGE
v6.critical 1:1
mail.label Last alert SMTP submission (not delivery)
mail.type GAUGE
mail.critical 1:1'''


def fetch():
    def safe(endpoint):
        try:return check(endpoint)
        except (OSError,ValueError,TimeoutError):return 0
    with ThreadPoolExecutor(max_workers=2) as pool:values=list(pool.map(safe,ENDPOINTS))
    return f'v4.value {values[0]}\nv6.value {values[1]}\nmail.value {submission_status()}'


if __name__=='__main__':
    if os.geteuid()!=pwd.getpwnam('munin').pw_uid or os.getegid()!=grp.getgrnam('munin').gr_gid:
        raise SystemExit('ntp_transport_j2 requires munin:munin')
    if sys.argv[1:] not in ([],['config']):raise SystemExit('only config/fetch supported')
    print(config() if sys.argv[1:] else fetch())
