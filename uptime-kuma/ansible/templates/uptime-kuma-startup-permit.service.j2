[Unit]
Description=Owner authority for guarded Kuma and Webmin startup
Wants=uptime-kuma-deployment-containment.timer
After=uptime-kuma-deployment-containment.timer time-sync.target
Before=uptime-kuma.service uptime-kuma-network.service uptime-kuma-loopback.socket uptime-kuma-loopback.service webmin.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/libexec/uptime-kuma/startup-permit.py grant
TimeoutStartSec=15s
