APT::Periodic::Enable "1";
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Unattended-Upgrade "1";

#clear Unattended-Upgrade::Allowed-Origins;
#clear Unattended-Upgrade::Origins-Pattern;
Unattended-Upgrade::Origins-Pattern {
    "site=deb.debian.org,origin=Debian,label=Debian,codename=trixie";
    "site=deb.debian.org,origin=Debian,label=Debian,codename=trixie-updates";
    "site=deb.debian.org,origin=Debian,label=Debian-Security,codename=trixie-security";
    "site=archive.raspberrypi.com,origin=Raspberry Pi Foundation,label=Raspberry Pi Foundation,codename=trixie";
};
Unattended-Upgrade::Automatic-Reboot "false";
Unattended-Upgrade::Remove-Unused-Dependencies "false";
Unattended-Upgrade::Remove-New-Unused-Dependencies "false";
Unattended-Upgrade::Remove-Unused-Kernel-Packages "false";
Unattended-Upgrade::Mail "notify@mailrise.xyz";
Unattended-Upgrade::MailReport "on-change";
